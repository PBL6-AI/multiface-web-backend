# HTTP server
PORT=3000

# Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=multiface
DB_SYNCHRONIZE=false
DB_SSL=false

# Redis / queue configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
ENROLLMENT_QUEUE_NAME=face-enrollment-processing

# JWT configuration
JWT_ACCESS_SECRET=replace-with-a-strong-access-secret
JWT_REFRESH_SECRET=replace-with-a-strong-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI service integration
AI_PROVIDER=http
AI_BASE_URL=http://localhost:8000
AI_ATTENDANCE_CONTROL_URL=http://localhost:5000
AI_TIMEOUT_MS=15000
AI_AUTH_TOKEN=

# Edge ingestion
EDGE_INGEST_TOKEN=

# S3-compatible storage
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_SIGNED_URL_EXPIRES_IN_SECONDS=900
